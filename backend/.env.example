# Copy to .env for local development. On AWS these come from the task definition
# (plain settings) and Secrets Manager (tokens). Leave a block empty to switch it off.

# ---------- Runtime ----------
APP_ENV=dev                     # prod hides the reset button and the test-without-apps endpoints
ROLE=all                        # all = API + worker in one process (local); api / worker in production
TZ=IST-5:30                     # the team's clock: "9 pm" and "today" in chat; servers run in UTC (POSIX form, needs no tzdata)
PUBLIC_BASE_URL=http://localhost:8000   # public HTTPS URL in production; used in webhook URLs

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=             # from @BotFather
LEAD_TELEGRAM_ID=               # optional: this Telegram user becomes the lead

# ---------- Slack (deploy/slack-manifest.yaml) ----------
SLACK_BOT_TOKEN=                # xoxb-...  OAuth & Permissions
SLACK_SIGNING_SECRET=           # Basic Information; enables HTTP events at /api/slack/events
SLACK_APP_TOKEN=                # xapp-...  only for Socket Mode in local development
SLACK_PROJECT_CHANNEL=          # channel ID the agent watches for belief conflicts (empty = any channel it's in)
SLACK_SUMMARY_CHANNEL=          # channel ID for meeting summaries (e.g. #proj-coordinator-meetings)
SLACK_ALERT_CHANNEL=            # channel ID for escalations and failed sends (e.g. #alert-coordinator)

# ---------- Microsoft Teams (Azure Bot + deploy/teams-manifest) ----------
TEAMS_CLIENT_ID=                # Entra app (client) ID of the Azure Bot
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=                # single-tenant bots: your tenant ID

# ---------- Meeting agent (Recall.ai joins Teams / Zoom / Meet) ----------
RECALL_API_KEY=
RECALL_REGION=us-east-1
RECALL_BOT_NAME=Project Coordinator
WEBHOOK_TOKEN=change-me         # secret put in the Recall webhook URL
MEETING_AUTO_APPLY=false        # false: status heard in meetings waits for the lead

# ---------- Jev: typed decisions (https://openrouter.ai/settings/keys) ----------
OPENROUTER_API_KEY=
JEV_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.14     # pin a version so thresholds stay stable
JEV_MIN_CONFIDENCE=0.6
JEV_CONCURRENCY=8               # parallel Jev calls when triaging a meeting

# ---------- LLM: hard replies, blocker wording, meeting summaries ----------
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=
LLM_MODEL=                      # free OpenCode model IDs rotate: https://opencode.ai/docs/zen/
LLM_FALLBACK_MODEL=

# ---------- Behaviour ----------
MODE=auto                       # auto | draft (lead approves every change)
AUTO_APPLY_CONFIDENCE=0.75
COMPLETE_CONFIDENCE=0.85
FOLLOWUP_INTERVAL_MIN=0         # scheduled check-ins; 0 = only on /checkin or the dashboard button
STALE_AFTER_MIN=60

# ---------- Scheduling intelligence (docs/INTELLIGENCE.md) ----------
INTEL_AUTORUN=true              # replan automatically after status changes (needs the worker/all role)
INTEL_DEBOUNCE_S=2              # coalesce bursts of events
INTEL_SOLVER_TIME_S=2           # CP-SAT time limit per solve
INTEL_DEFAULT_TASK_MIN=60       # used (and flagged) when a task has no estimate; est_minutes column in data/tasks.csv
INTEL_UNKNOWN_UNBLOCK_MIN=240   # pessimistic placeholder when nobody knows when a blocker clears (never zero)
INTEL_COOLDOWN_MIN=30           # same message, same situation, same person
INTEL_MIN_GAP_MIN=5             # any two messages to one person about one task
INTEL_MAX_ATTEMPTS=3            # unanswered nudges before escalating to the lead
INTEL_MAX_ACTIONS_PER_RUN=2
INTEL_COMMIT_GRACE_MIN=5        # wait this long after a promised time before chasing
AUTO_TASKS=true                 # read ordinary group conversation: create tasks, owners and dependencies by itself
AUTO_TASK_MIN_CONFIDENCE=0.7    # below this the agent stays silent instead of guessing
TELEGRAM_GROUP_CHAT_ID=         # the team's group (e.g. -100123...); learned automatically if empty
NEO4J_URI=                      # optional read-only mirror, e.g. bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=             # blank = default. Aura: NEO4J_URI=neo4j+s://<id>.databases.neo4j.io

# ---------- Infrastructure ----------
DATABASE_URL=sqlite:///./coordinator.db     # postgresql+psycopg://user:pass@host:5432/db in production
REDIS_URL=                      # redis://... enables multi-instance live updates and the job queue
AUTO_CREATE_TABLES=true         # production: false, and run `alembic upgrade head`
FRONTEND_ORIGIN=http://localhost:5173
LOG_JSON=false
OTEL_EXPORTER_OTLP_ENDPOINT=    # http://localhost:4318 with docker compose's Grafana stack
OTEL_SERVICE_NAME=coordinator
